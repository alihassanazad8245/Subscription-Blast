# ===========================================================================
# Subscription Form Tester - configuration
# Copy this file to ".env" (same folder) and edit the values.
#   Windows (PowerShell):  Copy-Item .env.example .env
# NEVER commit your real .env file: it is already listed in .gitignore.
# ===========================================================================

# --- REQUIRED --------------------------------------------------------------
# ONE email address that you own and may test with. Exactly one address.
TEST_EMAIL=you@example.com

# --- Firefox (optional) ----------------------------------------------------
# Leave empty to auto-detect Mozilla Firefox. Set it only if Firefox is
# installed somewhere unusual. Use the full path to firefox.exe, no quotes.
# FIREFOX_PATH=C:\Program Files\Mozilla Firefox\firefox.exe
FIREFOX_PATH=

# true = run Firefox without a visible window. false (default) lets you watch.
HEADLESS=false

# Seconds to wait for a page / its form to load (2-60).
PAGE_WAIT=8

# --- URL database (optional) -----------------------------------------------
# JSON file that stores your newsletter pages. Relative paths are resolved
# from this project folder.
URL_JSON=email_subscription.json

# Minimum minutes before the SAME url can be tested again (10-1440).
# This protects third-party sites from repeat requests.
TEST_COOLDOWN_MINUTES=30

# --- Search API (optional) -------------------------------------------------
# Only needed for menu option 5 (find newsletter pages). Works with Tavily
# (https://tavily.com) or any Tavily-compatible endpoint.
SEARCH_API_URL=https://api.tavily.com/search
SEARCH_API_KEY=
# Candidates fetched per search (1-20).
SEARCH_MAX_RESULTS=10

# --- IMAP (optional) -------------------------------------------------------
# Lets the tool watch YOUR mailbox for the confirmation/welcome email.
# Leave all of these empty to check your inbox by hand instead.
# Gmail/Outlook/Yahoo need an "app password", not your normal password.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Gmail: "[Gmail]/All Mail" also catches Promotions and Spam.
IMAP_FOLDER=INBOX
# Seconds to wait for the email to arrive (10-600).
IMAP_TIMEOUT=90
